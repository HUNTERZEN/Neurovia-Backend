# Server & URLs
APP_PORT=8080
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000,https://neurovia-tech-support.vercel.app,https://neurovia.site

# Secrets (Use strong >=32 char random strings in production)
JWT_SECRET=replace_with_a_32_plus_char_random_secret
SESSION_SECRET=replace_with_another_32_plus_char_secret

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/neurovia

# Email (Gmail App Password) & Company Team Notification Recipients
EMAIL_USER=neurovianexus8@gmail.com
EMAIL_PASS=your_gmail_app_password
COMPANY_TEAM_EMAILS=neurovianexus8@gmail.com,support@neurovia.site

# Razorpay Payment Gateway (Get Test/Live keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=optional_webhook_secret

# Company Admin Portal Credentials
ADMIN_USERNAME=neurovia-admin
ADMIN_EMAIL=neurovianexus8@gmail.com
ADMIN_PASSWORD=replace_with_strong_admin_password

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Twilio Video & Chat
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_API_KEY=your_twilio_api_key
TWILIO_API_SECRET=your_twilio_api_secret
TWILIO_CHAT_SERVICE_SID=your_twilio_chat_sid

